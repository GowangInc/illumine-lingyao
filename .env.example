# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# Google AdSense client ID (optional - for monetization)
# Get this from your AdSense dashboard
ADSENSE_CLIENT_ID=ca-pub-YOUR_ID_HERE

# Hugging Face token (optional - for downloading models)
# Get this from https://huggingface.co/settings/tokens
# Only needed if you're running the image/prompt generation locally
HF_TOKEN=hf_YOUR_TOKEN_HERE

# YouTube API credentials (optional - for video uploads)
# Place client_secrets.json in the root directory
# Do NOT commit client_secrets.json or youtube_token.pickle
